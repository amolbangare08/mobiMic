<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Black window background so there is no white flash between the launch window
      and the first Compose frame. That flash is small, but it is the first thing
      anyone sees, and it undoes the impression the rest of the app is trying to make.
    -->
    <style name="Theme.MobiMic" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
